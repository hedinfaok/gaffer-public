# Hello gaffer-exec
#
# The smallest useful task graph: two independent tasks that can run in
# parallel, an aggregate target that depends on both, and one cached target.
#
#   gaffer-exec --workspace-root . run make:hello
#   gaffer-exec --workspace-root . run --cache sha256 make:cached
#
# The same targets also work with plain make:
#
#   make hello

.DEFAULT_GOAL := hello

.PHONY: hello hello-a hello-b cached

# Aggregate target: waits for both independent tasks, then prints a summary
hello: hello-a hello-b
	@echo "→ hello graph complete"

# Independent task A (no dependencies)
hello-a:
	@echo "hello from task A"

# Independent task B (no dependencies, runs alongside A)
hello-b:
	@echo "hello from task B"

# Cached target: writes a file so `--cache sha256` can store and restore it
cached:
	@mkdir -p out
	@echo "generated by gaffer-exec" > out/stamp.txt
	@echo "✓ cached task ran"
